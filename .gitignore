# Dependencies
node_modules/

# Local environment / secrets (workspace / tenant / client IDs)
.env.local
*.env.local
.env.*.local

# Build output
dist/
build/
*.tsbuildinfo

# Rayfin local state / provisioning cache
.rayfin/
**/.rayfin-cache/

# Deployment state + temp files written by scripts/deploy.ps1
scripts/.deploy-state.json
scripts/.ws-id.tmp

# Rayfin per-deployment env + state (generated by deploy.ps1 / rayfin up)
app/rayfin/.env
app/rayfin/.env.bak
app/rayfin/.deployments.json


# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Prebuilt production bundle kept locally as a backup; deployments build from
# app/src by default, so this is not committed.
app/prebuilt/
