# Frontend (Vite) configuration for the lineage app.
# Copy this file to `.env.local` and fill in your values.

# --- Entra / Fabric identity ---
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
VITE_FABRIC_ITEM_ID=00000000-0000-0000-0000-000000000000
VITE_FABRIC_PORTAL_URL=https://app.fabric.microsoft.com

# --- Eventhouse / KQL (OpenLineage events) ---
VITE_KUSTO_CLUSTER_URI=https://<your-eventhouse>.kusto.fabric.microsoft.com
VITE_KUSTO_DATABASE=lineage_eh

# --- Lineage workspace (OneLake namespace that emits the events) ---
VITE_LINEAGE_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# --- App login behaviour ---
# false = users are only prompted to sign in when a view first needs a token.
VITE_REQUIRE_APP_LOGIN=false
